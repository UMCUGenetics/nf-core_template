/*
========================================================================================
    Nextflow config file for running tests
========================================================================================
*/

params {
    config_profile_name = "Test profile"

    // Limit resources so that this can (ideally) run anywhere
    max_cpus   = 1
    max_memory = 1.GB
    max_time   = 10.m

    // TODO: add parameters that are required for testing the workflow
    // test_data = "/path/to/test_data"


}
